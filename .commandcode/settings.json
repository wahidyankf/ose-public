{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(SHELL|READ|READ_MULTI|LIST|WRITE|EDIT|SEARCH|GLOB)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.commandcode/hooks/run-policy-hook.sh\" agent-policy",
            "timeout": 30,
            "failClosed": true
          }
        ]
      },
      {
        "matcher": "^(WRITE|EDIT|SHELL)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.commandcode/hooks/run-policy-hook.sh\" remind-rules-propagation",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(WRITE|EDIT)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.commandcode/hooks/run-policy-hook.sh\" format-lint-markdown",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
