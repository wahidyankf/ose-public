[Bb]in/
[Oo]bj/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
*.binlog
# AltCover default output
coverage.xml

# Dart tool state (generated locally by pub and test commands)
**/.dart_tool/

# File uploads (generated by integration tests, e.g. demo-be-java-vertx attachments)
**/file-uploads/

# Generated contract code (regenerated by nx run <app>:codegen)
**/generated-contracts/
# Python variant (Python packages use underscores, not hyphens)
**/generated_contracts/
# Bundled OpenAPI spec + docs
specs/apps/a-demo/contracts/generated/
specs/apps/ose/lms-be/contracts/generated/
# The roots and OSE ID contracts keep a hand-written README in their generated/ folder, so the
# folder itself is ignored by glob and the README negated back in — required because both trees are
# declared in `md-readme-index.trees`, whose gate walks the working tree and does not read
# .gitignore. The two siblings above ignore the whole directory instead; theirs hold nothing but
# build output.
specs/apps/ose/id-be/contracts/generated/*
!specs/apps/ose/id-be/contracts/generated/README.md
specs/apps/roots/be/contracts/generated/*
!specs/apps/roots/be/contracts/generated/README.md

# MemSearch vector index (local user-specific data)
.memsearch/

# Claude Code settings
.claude/settings.local.json
.claude/settings.local.json.bkup
.claude/worktrees/
/worktrees/*
!/worktrees/.gitkeep

# Manual-verification evidence belongs in the owning plan's evidence/ subfolder
# (plans/{backlog,in-progress,done}/<slug>/evidence/), which moves with the plan on
# archival — see repo-governance/development/quality/evidence-capture/.
# A repo-root evidence/ is always a misplacement. The leading slash anchors this to
# the root, so per-plan evidence/ folders are unaffected.
/evidence/

# OpenCode generated files (package.json and lockfiles are local MCP runner artifacts)
.opencode/package-lock.json
.opencode/settings.local.json
.opencode/opencode.local.json
.claude/*.lock

# Downloaded CI tooling binaries (downloaded on-demand during local testing)
actionlint

# Vercel CLI link state — contains orgId/projectId, must not land in this public repo
.vercel/

# FVM Version Cache
.fvm/
.fvm-cache/
