!local-tmp/.gitkeep

# Generated reports
# `**/` is load-bearing: a pattern containing a non-trailing slash is anchored
# to this file's directory, so `generated-reports/*` alone would leave a nested
# apps/<x>/generated-reports/ entirely untracked-and-visible. Matching contents
# rather than the directory itself (`/*`, not `/`) is also load-bearing: git
# cannot re-include a file whose parent directory is excluded, so `!.gitkeep`
# below only works while the directory stays un-excluded.
**/generated-reports/*
!**/generated-reports/.gitkeep

# Cache
.eslintcache
.cache/

# Link validation cache (note: this file is committed to share verification state)

# Playwright MCP
.playwright-mcp/

# Database
*.db
*.sqlite
*.sqlite3

# API keys and secrets
.secrets/
secrets.json

# Sensitive fintech files
*.pem
*.key
*.crt
*.pfx

# Java / Maven / Gradle build artifacts
target/
*.class
*.jar
*.exec

# The Gradle wrapper JAR is not a build artifact: it is the wrapper contract, and a clone
# without it cannot run `./gradlew` at all. The `*.jar` rule above would swallow it silently,
# so every Gradle root re-includes its own.
!apps/*/gradle/wrapper/gradle-wrapper.jar

# Rust build artifacts + shared-cache `target` symlinks created by
# `rhino-cli doctor --fix` (the `target/` rule above matches directories only,
# not the symlink form, so the symlinked `target` entries need their own rule)
target

# Python cache and virtual environments
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.venv/
.coverage

# Go intermediate coverage files and build artifacts
cover_*.out
apps/a-demo-be-golang-gin/server

