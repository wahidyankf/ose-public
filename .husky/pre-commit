#!/usr/bin/env sh
set -e

# Generated shim — do not add checks here. The pinned RHINO binary runs the
# core gates repo-config.yml declares for the `pre-commit` surface: the
# public-safety screen first, then this repository's registry. Declare checks
# under `extensions.rhino-cli.gates` with a `pre-commit` surface; they run in
# declaration order, which is why the registry lists the staged guard first,
# then the per-file pass, then the re-staging mutations.
#
# The registry dispatcher delegates the per-file pass to
# `npx lint-staged`, whose block in package.json is itself generated from the
# registry by `gate emit`. lint-staged keeps its stash-and-restore safety.
exec ./rhino gate run --surface pre-commit
