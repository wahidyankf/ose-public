{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.2",
  "small_model": "zai-coding-plan/glm-5.2",
  "provider": {
    "zai-coding-plan": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZHIPU_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.development": "deny",
      "**/.env.production": "deny",
      "**/.env.staging": "deny",
      "**/.env.prod": "deny",
      "**/.env.stag": "deny",
      "**/.env.test": "deny",
      "**/.env.example": "allow",
      "apps/*/content/**/*.env": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.development": "deny",
      "**/.env.production": "deny",
      "**/.env.staging": "deny",
      "**/.env.prod": "deny",
      "**/.env.stag": "deny",
      "**/.env.test": "deny",
      "**/.env.example": "allow",
      "apps/*/content/**/*.env": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    }
  }
}
