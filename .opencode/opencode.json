{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.2",
  "small_model": "zai-coding-plan/glm-5.2",
  "provider": {
    "zai-coding-plan": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZHIPU_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.development": "deny",
      "**/.env.production": "deny",
      "**/.env.staging": "deny",
      "**/.env.prod": "deny",
      "**/.env.stag": "deny",
      "**/.env.test": "deny",
      "**/.env.example": "allow",
      "apps/*/content/**/*.env": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.development": "deny",
      "**/.env.production": "deny",
      "**/.env.staging": "deny",
      "**/.env.prod": "deny",
      "**/.env.stag": "deny",
      "**/.env.test": "deny",
      "**/.env.example": "allow",
      "apps/*/content/**/*.env": "allow"
    },
    "bash": {
      "*": "allow",
      "npm install*": "deny",
      "rtk npm install*": "deny",
      "npm ci*": "deny",
      "rtk npm ci*": "deny",
      "npm exec*": "deny",
      "rtk npm exec*": "deny",
      "npx *": "deny",
      "rtk npx *": "deny",
      "nx run*": "deny",
      "rtk nx run*": "deny",
      "nx affected*": "deny",
      "rtk nx affected*": "deny",
      "dotnet build*": "deny",
      "rtk dotnet build*": "deny",
      "dotnet publish*": "deny",
      "rtk dotnet publish*": "deny",
      "dotnet test*": "deny",
      "rtk dotnet test*": "deny",
      "dotnet run*": "deny",
      "rtk dotnet run*": "deny",
      "dotnet restore*": "deny",
      "rtk dotnet restore*": "deny",
      "dotnet format*": "deny",
      "rtk dotnet format*": "deny",
      "dotnet watch*": "deny",
      "rtk dotnet watch*": "deny",
      "cargo build*": "deny",
      "rtk cargo build*": "deny",
      "cargo test*": "deny",
      "rtk cargo test*": "deny",
      "cargo run*": "deny",
      "rtk cargo run*": "deny",
      "cargo clippy*": "deny",
      "rtk cargo clippy*": "deny",
      "cargo xtask*": "deny",
      "rtk cargo xtask*": "deny",
      "mix deps.get*": "deny",
      "rtk mix deps.get*": "deny",
      "mix compile*": "deny",
      "rtk mix compile*": "deny",
      "mix test*": "deny",
      "rtk mix test*": "deny",
      "mix phx.server*": "deny",
      "rtk mix phx.server*": "deny",
      "*./hippo run*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    }
  }
}
