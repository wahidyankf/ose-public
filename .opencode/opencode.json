{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env.prod": "deny",
      "**/.env.stag": "deny",
      "**/.env.example": "allow",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env.prod": "deny",
      "**/.env.stag": "deny",
      "**/.env.example": "allow",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny"
    },
    "bash": {
      "*": "allow",
      "npm install*": "deny",
      "rtk npm install*": "deny",
      "npm ci*": "deny",
      "rtk npm ci*": "deny",
      "npm exec*": "deny",
      "rtk npm exec*": "deny",
      "npx *": "deny",
      "rtk npx *": "deny",
      "nx run*": "deny",
      "rtk nx run*": "deny",
      "nx affected*": "deny",
      "rtk nx affected*": "deny",
      "dotnet build*": "deny",
      "rtk dotnet build*": "deny",
      "dotnet publish*": "deny",
      "rtk dotnet publish*": "deny",
      "dotnet test*": "deny",
      "rtk dotnet test*": "deny",
      "dotnet run*": "deny",
      "rtk dotnet run*": "deny",
      "dotnet restore*": "deny",
      "rtk dotnet restore*": "deny",
      "dotnet format*": "deny",
      "rtk dotnet format*": "deny",
      "dotnet watch*": "deny",
      "rtk dotnet watch*": "deny",
      "cargo build*": "deny",
      "rtk cargo build*": "deny",
      "cargo test*": "deny",
      "rtk cargo test*": "deny",
      "cargo run*": "deny",
      "rtk cargo run*": "deny",
      "cargo clippy*": "deny",
      "rtk cargo clippy*": "deny",
      "cargo xtask*": "deny",
      "rtk cargo xtask*": "deny",
      "mix deps.get*": "deny",
      "rtk mix deps.get*": "deny",
      "mix compile*": "deny",
      "rtk mix compile*": "deny",
      "mix test*": "deny",
      "rtk mix test*": "deny",
      "mix phx.server*": "deny",
      "rtk mix phx.server*": "deny",
      "*./hippo run*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "external_directory": {
      "/tmp/**": "allow"
    },
    "*": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    }
  }
}
