# Java 25 on Temurin plus the JarFetch installer.
# The fetcher line below regenerates toolchains/java/JarFetch.java byte for byte
# (base64 keeps every quote intact; the byte-identity unit decodes and pins it): a
# toolchain build's context holds only this Dockerfile, so the recipe cannot COPY
# the source file. The decode avoids a pipe (hadolint DL4006) by staging through
# a temp file removed in the same layer.
FROM docker.io/library/eclipse-temurin:25-jdk@sha256:2d5d5e9b533342a565907c84f47a2ec298c40cde7b13a3ca85d4950fa456a641
RUN mkdir -p /opt/tools && echo '' > /tmp/JarFetch.b64 && base64 -d /tmp/JarFetch.b64 > /opt/tools/JarFetch.java && rm /tmp/JarFetch.b64
# The usage probe proves the generated copy parses and runs: no arguments
# must exit 2, any other code means the transcription broke.
RUN java /opt/tools/JarFetch.java < /dev/null > /dev/null 2>&1; test $? -eq 2
