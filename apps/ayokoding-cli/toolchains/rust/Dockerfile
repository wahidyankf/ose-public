# Rust 1.99 plus the fetch.py crate installer.
# The fetcher line below regenerates toolchains/rust/fetch.py byte for byte
# (base64 keeps every quote intact; a toolchain build's context holds only
# this Dockerfile, so the recipe cannot COPY the source file). The decode
# avoids a pipe (hadolint DL4006) by staging through a temp file removed in
# the same layer.
FROM docker.io/library/rust:1.99@sha256:e259494b14672950a909b4c54527e19d29cae6ebf980672114c8bb85e5594e4a
RUN mkdir -p /opt/tools && echo '' > /tmp/fetch.b64 && base64 -d /tmp/fetch.b64 > /opt/tools/fetch.py && rm /tmp/fetch.b64
# The usage probe proves the generated copy parses and runs: no arguments
# must exit 2, any other code means the transcription broke.
RUN python3 /opt/tools/fetch.py < /dev/null > /dev/null 2>&1; test $? -eq 2
