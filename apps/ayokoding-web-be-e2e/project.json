{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ayokoding-web-be-e2e",
  "sourceRoot": "apps/ayokoding-web-be-e2e/tests",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/ayokoding-web-be-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "apps/ayokoding-web-be-e2e"
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ayokoding-web-be-e2e:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-web-be-e2e:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-web-be-e2e:test:behaviour:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ayokoding/web/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ayokoding-web-be-e2e/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-web-be-e2e/playwright.real-corpus.config.ts",
        "{workspaceRoot}/apps/ayokoding-web-be-e2e/playwright.fixture.config.ts",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\\\$?test\\\\.skip\\\\([^,)]*\\\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && if [ -n \"$BASE_URL\" ]; then npx bddgen --config=playwright.real-corpus.config.ts && npx playwright test --config=playwright.real-corpus.config.ts; else npx bddgen --config=playwright.fixture.config.ts && npx playwright test --config=playwright.fixture.config.ts && npx bddgen --config=playwright.real-corpus.config.ts && npx playwright test --config=playwright.real-corpus.config.ts; fi",
        "cwd": "apps/ayokoding-web-be-e2e"
      },
      "dependsOn": [{ "target": "build", "projects": "ayokoding-web" }]
    },
    "test:behaviour:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./rhino behaviour coverage validate",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen --config=playwright.real-corpus.config.ts && npx playwright test --ui --config=playwright.real-corpus.config.ts",
        "cwd": "apps/ayokoding-web-be-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/ayokoding-web-be-e2e"
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:ayokoding"]
}
