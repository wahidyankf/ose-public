# Local-only settings for the ayokoding-web Go server.
# Copy to .env.local (uncommitted) when overriding the listener.
# Never commit real secrets; never touch .env.prod / .env.stag.

# Explicit listener port (1-65535). Default: 3102.
AYOKODING_WEB_PORT=3102

# Read-only source roots, resolved relative to apps/ayokoding-web.
AYOKODING_WEB_CONTENT_DIR=../ayokoding-www/content
AYOKODING_WEB_MANIFESTS_DIR=../ayokoding-www/src/features/course-paths/manifests

# Show draft content. Keep false outside owned test/authoring fixtures.
AYOKODING_WEB_SHOW_DRAFTS=false
