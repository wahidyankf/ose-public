# Local-only settings for the ayokoding-web Go server.
# Copy to .env.local (uncommitted) when overriding the listener.
# Never commit real secrets; never touch .env.prod / .env.stag.

# Explicit listener port (1-65535). Default: 3102.
AYOKODING_WEB_PORT=3102

# Source roots are optional. Unset, the default start serves the real corpus found from the repository root
# (see README.md, "Corpus"). Set them only to point the launcher at another corpus.
# AYOKODING_WEB_CONTENT_DIR=/absolute/path/to/content
# AYOKODING_WEB_MANIFESTS_DIR=/absolute/path/to/manifests

# Fixture selection. Unset, the launcher serves the real corpus. Set to parity or unavailable-catalog only for owned
# tests and authoring; the canned fixture is never served otherwise.
# AYOKODING_WEB_FIXTURE=parity

# Show draft content. Keep false outside owned test/authoring fixtures.
AYOKODING_WEB_SHOW_DRAFTS=false
