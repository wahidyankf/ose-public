# ayokoding-www — environment variable template
# Copy to .env.local for local development; never commit real secrets.

# OPTIONAL | string | Absolute path to content directory (default: apps/ayokoding-www/content)
# AYOKODING_WEB_CONTENT_DIR=

# OPTIONAL | string | Absolute path to path-manifests directory (default: apps/ayokoding-www/src/features/course-paths/manifests)
# AYOKODING_WEB_MANIFESTS_DIR=

# OPTIONAL | boolean | Include draft posts in listing; set to "true" to enable (default: false)
# AYOKODING_WEB_SHOW_DRAFTS=

# OPTIONAL | string | Next.js dev-server hostname (framework-reserved name; default: 0.0.0.0)
# HOSTNAME=0.0.0.0

# OPTIONAL | u16 | Listener port (default: 3101)
# Format: `--port` flag first, then this variable, then the default; a bare PORT is not honoured
# AYOKODING_WWW_PORT=3101

# OPTIONAL | string | Local Next.js build worker cap; ignored in CI and Vercel (default: 2)
# Format: 1 or 2
# AYOKODING_WWW_BUILD_WORKERS=
