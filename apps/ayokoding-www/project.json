{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ayokoding-www",
  "sourceRoot": "apps/ayokoding-www/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No codegen needed — ayokoding-www has no OpenAPI contract'",
        "cwd": "apps/ayokoding-www"
      }
    },
    "generate-indexes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts",
        "cwd": "apps/ayokoding-www"
      }
    },
    "validate-indexes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts --validate",
        "cwd": "apps/ayokoding-www"
      }
    },
    "generate-benchmark-reference": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-benchmark-reference.ts",
        "cwd": "apps/ayokoding-www"
      }
    },
    "validate-benchmark-reference": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-benchmark-reference.ts --validate",
        "cwd": "apps/ayokoding-www"
      }
    },
    "generate-search-data": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/features/search/shell/generate-search-data.ts",
        "cwd": "apps/ayokoding-www"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts && node ../../scripts/next-with-port.mjs dev --env AYOKODING_WWW_PORT --default 3101",
        "cwd": "apps/ayokoding-www"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/ayokoding-www"
      },
      "outputs": ["{projectRoot}/.next"],
      "dependsOn": ["generate-indexes", "generate-search-data"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs start --env AYOKODING_WWW_PORT --default 3101",
        "cwd": "apps/ayokoding-www"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/ayokoding-www"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --jsx-a11y-plugin .",
        "cwd": "apps/ayokoding-www"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/ayokoding/**/*.feature",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/**/*"
      ],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run --project unit --project unit-fe --coverage --coverage.thresholds.lines=99 --testTimeout=60000",
        "cwd": "apps/ayokoding-www"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/build-tools/**/*.feature",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/integration/**/*",
        "{projectRoot}/vitest.integration.config.ts"
      ],
      "options": {
        "command": "npx vitest run --config vitest.integration.config.ts --testTimeout=60000",
        "cwd": "apps/ayokoding-www"
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ayokoding-www:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-www:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-www:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-www:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ayokoding-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ayokoding-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.config.ts",
        "{workspaceRoot}/apps/ayokoding-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.integration.config.ts",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/playwright.config.ts"
      ]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ayokoding-www/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ayokoding-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ayokoding-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.config.ts",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ayokoding-www/behaviour-coverage.json --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ayokoding-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ayokoding-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.integration.config.ts"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ayokoding-www/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ayokoding-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ayokoding-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.config.ts",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ayokoding-www/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ayokoding-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ayokoding-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.config.ts",
        "{workspaceRoot}/apps/ayokoding-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.integration.config.ts",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ayokoding-www:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-www:test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-www:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-www:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ayokoding-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ayokoding-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.config.ts",
        "{workspaceRoot}/apps/ayokoding-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www/vitest.integration.config.ts",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ayokoding-www-fe-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": [
      "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/frontend/**/*.feature",
      "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/backend/**/*.feature",
      "{workspaceRoot}/specs/apps/ayokoding/www/behaviours/build-tools/**/*.feature"
    ]
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:ayokoding"]
}
