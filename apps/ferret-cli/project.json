{
  "name": "ferret-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ferret-cli/src",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --locked",
        "cwd": "apps/ferret-cli"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync python scripts/build_zipapp.py",
        "cwd": "apps/ferret-cli"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/scripts/build_zipapp.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version"
      ]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync python dist/ferret.pyz",
        "cwd": "apps/ferret-cli"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "uv run --no-sync ruff check .",
            "forwardAllArgs": false
          },
          {
            "command": "uv run --no-sync ruff format --check .",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false,
        "cwd": "apps/ferret-cli"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/tests/**/*.py",
        "{projectRoot}/scripts/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync pyright",
        "cwd": "apps/ferret-cli"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/tests/**/*.py",
        "{projectRoot}/scripts/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync pytest tests/unit --cov=ferret --cov-report=term-missing --cov-fail-under=99",
        "cwd": "apps/ferret-cli"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/tests/**/*.py",
        "{projectRoot}/scripts/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{workspaceRoot}/specs/apps/ferret/cli/behaviours/**/*.feature",
        "{projectRoot}/tests/support/opencode_driver.mjs",
        "{projectRoot}/tests/support/opencode_timer_driver.mjs",
        "{workspaceRoot}/.claude/hooks/ferret-capture.sh",
        "{workspaceRoot}/.opencode/plugins/ferret.ts"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync pytest tests/integration",
        "cwd": "apps/ferret-cli"
      },
      "cache": false
    },
    "test:behaviour:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./rhino behaviour coverage validate",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ferret-cli:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ferret-cli:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ferret-cli:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ferret-cli:test:behaviour:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/tests/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{workspaceRoot}/specs/apps/ferret/cli/behaviours/**/*.feature",
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/scripts/**/*.py",
        "{projectRoot}/uv.lock",
        "{projectRoot}/.python-version",
        "{workspaceRoot}/.claude/hooks/ferret-capture.sh",
        "{workspaceRoot}/.opencode/plugins/ferret.ts",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    }
  },
  "tags": ["type:app", "platform:cli", "lang:python", "domain:ferret"]
}
