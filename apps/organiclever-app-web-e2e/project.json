{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "organiclever-app-web-e2e",
  "sourceRoot": "apps/organiclever-app-web-e2e/steps",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright install --with-deps chromium",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/specs/apps/organiclever/app-web/behaviours/**/*.feature"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "{projectRoot}"
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run organiclever-app-web-e2e:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-app-web-e2e:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-app-web-e2e:test:behaviour:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/app-web/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-app-web/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-app-web/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-app-web-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-app-web-e2e/playwright.config.ts",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npx bddgen && env -u WEB_BASE_URL PLAYWRIGHT_GREP_INVERT=@local-fullstack npx playwright test",
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "dependsOn": ["organiclever-app-web:build"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npx bddgen && PLAYWRIGHT_GREP_INVERT=@local-fullstack npx playwright test",
        "cwd": "{projectRoot}"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "{projectRoot}"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "{projectRoot}"
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "test:behaviour:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./rhino behaviour coverage validate",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:organiclever"],
  "implicitDependencies": ["organiclever-app-web", "organiclever-be"],
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/organiclever/app-web/behaviours/**/*.feature"]
  }
}
