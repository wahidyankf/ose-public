{
  "name": "organiclever-be-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/organiclever-be-e2e/steps",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/organiclever-be-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "apps/organiclever-be-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx tsc --noEmit",
        "cwd": "apps/organiclever-be-e2e"
      },
      "inputs": ["default", "{workspaceRoot}/specs/apps/organiclever/be/behaviours/**/*.feature"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run organiclever-be-e2e:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-be-e2e:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-be-e2e:test:coverage",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-be-e2e:test:behaviour:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-be-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-be/tests/unit/OrganicleverBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/organiclever-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-be-e2e/playwright.config.ts",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/organiclever-be/scripts/run-e2e.sh"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "apps/organiclever-be-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/organiclever-be-e2e"
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/organiclever-be-e2e/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-be-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-be/tests/unit/OrganicleverBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/organiclever-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-be-e2e/playwright.config.ts"
      ]
    },
    "test:behaviour:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./rhino behaviour coverage validate",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run organiclever-be-e2e:test:coverage:e2e",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-be-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-be/tests/unit/OrganicleverBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/organiclever-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-be-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/organiclever/be/behaviours/**/*.feature"]
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:organiclever"],
  "implicitDependencies": ["organiclever-be"]
}
