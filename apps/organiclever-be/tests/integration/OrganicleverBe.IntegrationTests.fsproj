<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OtherFlags>--nowarn:3261 --nowarn:3264</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestCollections.fs" />
    <Compile Include="Steps/EnvTierSteps.fs" />
    <Compile Include="Steps/NatsConfigSteps.fs" />
    <Compile Include="Tests/EnvTierLoaderIntegrationTests.fs" />
    <Compile Include="Tests/NatsConfigIntegrationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TickSpec" Version="2.0.5" />
    <!-- Must be >= the FSharp.Core the .NET SDK implicitly references, or NuGet
         reports NU1605: the referenced app project takes the SDK's implicit
         version, this project takes the literal below, and a lower literal is a
         downgrade. `setup-dotnet` floats `10.0.x`, so the implicit version moves
         when a patch SDK ships; 10.0.402 raised it to 10.1.402, and a later patch SDK raised the implicit version to 10.1.403. -->
    <PackageReference Update="FSharp.Core" Version="10.1.403" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OrganicleverBe/OrganicleverBe.fsproj" />
  </ItemGroup>

</Project>
