{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "organiclever-www-fe-e2e",
  "sourceRoot": "apps/organiclever-www-fe-e2e/src",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/organiclever-www-fe-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "apps/organiclever-www-fe-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/organiclever-www-fe-e2e"
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run organiclever-www-fe-e2e:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www-fe-e2e:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www-fe-e2e:test:coverage",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www-fe-e2e:test:behaviour:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npm exec -- nx run organiclever-www:build && npx bddgen && env -u BASE_URL npx playwright test",
        "cwd": "apps/organiclever-www-fe-e2e"
      },
      "cache": false
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "inputs": ["default", "{workspaceRoot}/specs/apps/organiclever/www/behaviours/frontend/**/*.feature"],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npm exec -- nx run organiclever-www:build && npx bddgen && npx playwright test",
        "cwd": "apps/organiclever-www-fe-e2e"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "apps/organiclever-www-fe-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/organiclever-www-fe-e2e"
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/organiclever-www-fe-e2e/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:behaviour:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./rhino behaviour coverage validate",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run organiclever-www-fe-e2e:test:coverage:e2e",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts"
      ]
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:organiclever"],
  "implicitDependencies": ["organiclever-www"],
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/organiclever/www/behaviours/frontend/**/*.feature"]
  }
}
