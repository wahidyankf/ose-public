{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "organiclever-www",
  "sourceRoot": "apps/organiclever-www/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs dev --env ORGANICLEVER_WWW_PORT --default 3200",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs start --env ORGANICLEVER_WWW_PORT --default 3200",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --jsx-a11y-plugin .",
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/oxlint.json", "{projectRoot}/tsconfig.json"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/frontend/**/*.feature",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/unit/**/*"
      ],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run --coverage --coverage.thresholds.lines=99",
        "cwd": "apps/organiclever-www"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run organiclever-www:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts"
      ]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/organiclever-www/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/organiclever-www/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/organiclever-www/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run organiclever-www:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run organiclever-www:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/organiclever-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/organiclever/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/organiclever-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www/vitest.config.ts",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/organiclever-www-fe-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/organiclever/www/behaviours/frontend/**/*.feature"]
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:organiclever"],
  "implicitDependencies": ["web-ui", "web-ui-token"]
}
