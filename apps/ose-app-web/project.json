{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ose-app-web",
  "sourceRoot": "apps/ose-app-web/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @hey-api/openapi-ts -i specs/apps/ose/be/contracts/generated/openapi-bundled.yaml -o apps/ose-app-web/src/generated-contracts -s && git diff --exit-code -- apps/ose-app-web/src/generated-contracts/"
      },
      "dependsOn": ["ose-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/ose/be/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/src/generated-contracts"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs dev --env OSE_APP_WEB_PORT --default 3300",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs start --env OSE_APP_WEB_PORT --default 3300",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --jsx-a11y-plugin . && npx eslint .",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/oxlint.json",
        "{projectRoot}/eslint.config.mjs",
        "{projectRoot}/tsconfig.json"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/src/generated-contracts/**/*",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/unit/**/*"
      ],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run --coverage --coverage.thresholds.lines=99",
        "cwd": "apps/ose-app-web"
      },
      "dependsOn": [],
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-app-web:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-app-web:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-app-web:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-app-web:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-app-web/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/app-web/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-app-web/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web/vitest.config.ts",
        "{workspaceRoot}/apps/ose-app-web-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web-e2e/playwright.config.ts"
      ]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx storybook dev -p 6006 --no-open",
        "cwd": "{projectRoot}"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "npx storybook build -o storybook-static",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-app-web/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-app-web/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/app-web/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-app-web/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web/vitest.config.ts",
        "{workspaceRoot}/apps/ose-app-web-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-app-web/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-app-web/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/app-web/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-app-web/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web/vitest.config.ts",
        "{workspaceRoot}/apps/ose-app-web-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-app-web/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-app-web/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/app-web/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-app-web/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web/vitest.config.ts",
        "{workspaceRoot}/apps/ose-app-web-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-app-web:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-app-web:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-app-web:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-app-web/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/app-web/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-app-web/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web/vitest.config.ts",
        "{workspaceRoot}/apps/ose-app-web-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-app-web-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ose/app-web/behaviours/**/*.feature"]
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:ose"],
  "implicitDependencies": ["ose-contracts", "web-ui", "web-ui-token"]
}
