{
  "name": "ose-be-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ose-be-e2e/steps",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/ose-be-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "apps/ose-be-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx tsc --noEmit",
        "cwd": "apps/ose-be-e2e"
      },
      "inputs": ["default", "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-be-e2e:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be-e2e:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be-e2e:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/ose-be/scripts/run-e2e.sh"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "apps/ose-be-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/ose-be-e2e"
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-be-e2e/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-be-e2e/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-be-e2e:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be-e2e:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature"]
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:ose"],
  "implicitDependencies": ["ose-be"]
}
