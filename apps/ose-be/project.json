{
  "name": "ose-be",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ose-be/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx openapi-generator-cli generate -i $(pwd)/specs/apps/ose/be/contracts/generated/openapi-bundled.yaml -g fsharp-giraffe-server -o $(pwd)/apps/ose-be/generated-contracts --model-package OseBe.Contracts --global-property=models,modelDocs=false,apiDocs=false"
      },
      "dependsOn": ["ose-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/ose/be/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/generated-contracts"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/ose-be/src/OseBe/OseBe.fsproj -c Release -o apps/ose-be/dist"
      },
      "dependsOn": ["codegen"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/OseBe/OseBe.fsproj",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/ose-be/src/OseBe/OseBe.fsproj"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/OseBe/OseBe.fsproj",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "lint": {
      "dependsOn": ["codegen", "typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet tool restore",
          "dotnet tool run fantomas --check apps/ose-be/src",
          "dotnet fsharplint lint apps/ose-be/src/OseBe/OseBe.fsproj --lint-config apps/ose-be/fsharplint.json",
          "dotnet fsharp-analyzers --project apps/ose-be/src/OseBe/OseBe.fsproj --analyzers-path $(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1) --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/OseBe/OseBe.fsproj"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet watch run --project apps/ose-be/src/OseBe/OseBe.fsproj"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/ose-be/src/OseBe/OseBe.fsproj"
      }
    },
    "test:unit": {
      "dependsOn": ["codegen", "typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=' apps/ose-be/tests/unit; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && dotnet test apps/ose-be/tests/unit/OseBe.UnitTests.fsproj /p:CollectCoverage=true /p:Threshold=99 \"/p:Include=[OseBe]*\" /p:ThresholdType=line \"/p:ExcludeByFile=**/OseBe/Program.fs%2C**/Contexts/Db/Infrastructure/DbMigrations.fs%2C**/Contexts/RegulatorySource/Infrastructure/RegulatorySourceInfrastructure.fs%2C**/Contexts/InternalPolicy/Infrastructure/InternalPolicyInfrastructure.fs%2C**/Infrastructure/Repositories/EfRepositories.fs%2C**/Contexts/Messaging/Infrastructure/JetStreamDemo.fs%2C**/Infrastructure/NatsConnect.fs%2C**/Infrastructure/OpenRouterConnect.fs\""
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/src/OseBe/OseBe.fsproj"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-be:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/integration/OseBe.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/ose-be/scripts/run-integration.sh"
      },
      "cache": false
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet list apps/ose-be/src/OseBe/OseBe.fsproj package --vulnerable"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for F#'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-be/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/integration/OseBe.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-be/behaviour-coverage.json --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/integration/OseBe.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-be/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/integration/OseBe.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-be/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/integration/OseBe.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-be:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be:test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-be:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-be/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/unit/OseBe.UnitTests.fsproj",
        "{workspaceRoot}/apps/ose-be/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be/tests/integration/OseBe.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/ose-be-e2e/steps/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-be-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ose/be/behaviours/**/*.feature"]
  },
  "tags": ["type:app", "platform:giraffe", "lang:fsharp", "domain:ose"],
  "implicitDependencies": ["ose-contracts"]
}
