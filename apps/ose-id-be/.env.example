# ose-id-be — environment variable template
# Copy to .env.local for local development; never commit real secrets.
# This service holds no credential, token, or session material: OSE ID authentication is not enabled.

# REQUIRED | string | Runtime mode this process may serve in; only `Local` or `Test` start
# Format: exact, case-sensitive value; anything else exits non-zero with `runtime_mode_disabled`
OSE_RUNTIME_MODE=Local

# OPTIONAL | u16 | Loopback listener port (default: 8501, reserved in docs/reference/web-sites.md)
# OSE_ID_BE_PORT=8501

# REQUIRED for /health/ready to succeed | string | Npgsql connection string for the serving
# process's read-only `ose_id_app` role. Distinct from OSE_ID_MIGRATION_CONNECTION below — the
# two must never collide or be satisfied by the same privilege.
# OSE_ID_CONNECTION=Host=localhost;Port=5438;Database=ose_id;Username=ose_id_app;Password=change-me

# REQUIRED for the migrator (OseId.Migrator) | string | Npgsql connection string for the
# schema-owning `ose_id_migrator` role. Never used by the serving process.
# OSE_ID_MIGRATION_CONNECTION=Host=localhost;Port=5438;Database=ose_id;Username=ose_id_migrator;Password=change-me
