<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Composition root and the only project that names a framework type. It validates
    the runtime mode before the serving pipeline exists, registers each port against
    exactly one adapter, and maps the closed inbound route table.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OseId.Host</RootNamespace>
    <AssemblyName>OseId.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OseId.Application/OseId.Application.csproj" />
    <ProjectReference Include="../OseId.Infrastructure/OseId.Infrastructure.csproj" />
  </ItemGroup>

</Project>
