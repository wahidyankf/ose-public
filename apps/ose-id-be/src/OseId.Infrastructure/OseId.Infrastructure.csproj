<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Outbound adapters. It implements ports the application declares and never calls
    an inbound adapter. Persistence adapters arrive with the PostgreSQL slice; the
    correlation-identifier adapter is here because generating an identifier is a
    side effect the application must not perform itself.
  -->
  <PropertyGroup>
    <RootNamespace>OseId.Infrastructure</RootNamespace>
    <AssemblyName>OseId.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OseId.Application/OseId.Application.csproj" />
  </ItemGroup>

</Project>
