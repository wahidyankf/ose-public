# ose-id-web — environment variable template
# Copy to .env.local for local development; never commit real secrets.
# This app holds no credential, token, or session material: OSE ID authentication is not enabled.

# REQUIRED | string | Runtime mode this process may serve in; only `Local` or `Test` start
# Format: exact, case-sensitive value; anything else exits non-zero with `runtime_mode_disabled`
OSE_RUNTIME_MODE=Local

# OPTIONAL | string | Server-only base URL of `ose-id-be`, read during the server render only
# Format: absolute loopback origin (`127.0.0.1`, `localhost`, or `[::1]`); anything else fails startup
# The browser never receives this value and never issues the readiness request itself.
# OSE_ID_BE_URL=http://127.0.0.1:8501

# OPTIONAL | u16 | Listener port (default: 3500)
# Format: `--port` flag first, then this variable, then the default; a bare PORT is not honoured
# OSE_ID_WEB_PORT=3500
