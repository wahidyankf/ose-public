{
  "name": "ose-lms-be",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ose-lms-be/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx openapi-generator-cli generate -i $(pwd)/specs/apps/ose/lms-be/contracts/generated/openapi-bundled.yaml -g spring -o $(pwd)/apps/ose-lms-be/generated-contracts --model-package com.oseplatform.lms.contracts --global-property=models,modelDocs=false,apiDocs=false --additional-properties=useJakartaEe=true,useBeanValidation=false,performBeanValidation=false,openApiNullable=false,annotationLibrary=none,documentationProvider=none"
      },
      "dependsOn": ["ose-lms-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/ose/lms-be/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/generated-contracts"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ose-lms-be",
        "command": "./gradlew --console=plain bootJar"
      },
      "dependsOn": ["codegen"],
      "outputs": ["{projectRoot}/build/libs"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/main/**/*",
        "{projectRoot}/generated-contracts/**/*.java",
        "{projectRoot}/build.gradle.kts",
        "{projectRoot}/settings.gradle.kts",
        "{projectRoot}/gradle.properties",
        "{projectRoot}/gradle/wrapper/gradle-wrapper.properties"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ose-lms-be",
        "command": "./gradlew --console=plain compileJava compileTestJava"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/generated-contracts/**/*.java",
        "{projectRoot}/build.gradle.kts",
        "{projectRoot}/settings.gradle.kts",
        "{projectRoot}/gradle.properties",
        "{projectRoot}/gradle/wrapper/gradle-wrapper.properties"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ose-lms-be",
        "command": "./gradlew --console=plain spotlessCheck"
      },
      "dependsOn": ["codegen", "typecheck"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.java",
        "{projectRoot}/build.gradle.kts",
        "{projectRoot}/gradle/wrapper/gradle-wrapper.properties"
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ose-lms-be",
        "command": "./gradlew --console=plain bootRun"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "java -jar apps/ose-lms-be/build/libs/ose-lms-be.jar"
      },
      "dependsOn": ["build"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.java' '@Disabled|@Ignore' apps/ose-lms-be/src/test/java; then echo 'ERROR: disabled JUnit test found in the files above'; exit 1; fi && (cd apps/ose-lms-be && ./gradlew --console=plain -Pcoverage.line.minimum=99 test jacocoTestCoverageVerification)"
      },
      "dependsOn": ["codegen", "typecheck"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/generated-contracts/**/*.java",
        "{projectRoot}/build.gradle.kts",
        "{workspaceRoot}/specs/apps/ose/lms-be/behaviours/**/*.feature"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-lms-be:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-lms-be:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-lms-be:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-lms-be:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-lms-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/lms-be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-lms-be/src/test/java/**/*.java"
      ]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ose-lms-be",
        "command": "./gradlew --console=plain dependencies --configuration runtimeClasspath"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: the Java toolchain floor is pinned in build.gradle.kts'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-lms-be/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-lms-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/lms-be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-lms-be/src/test/java/**/*.java"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-lms-be/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-lms-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/lms-be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-lms-be/src/test/java/**/*.java",
        "{workspaceRoot}/apps/ose-lms-be-e2e/steps/**/*.ts",
        "{workspaceRoot}/apps/ose-lms-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-lms-be/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-lms-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/lms-be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-lms-be/src/test/java/**/*.java"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-lms-be:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-lms-be:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-lms-be:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-lms-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/lms-be/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-lms-be/src/test/java/**/*.java",
        "{workspaceRoot}/apps/ose-lms-be-e2e/steps/**/*.ts",
        "{workspaceRoot}/apps/ose-lms-be-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ose/lms-be/behaviours/**/*.feature"]
  },
  "tags": ["type:app", "platform:springboot", "lang:java", "domain:ose"],
  "implicitDependencies": ["ose-lms-contracts"]
}
