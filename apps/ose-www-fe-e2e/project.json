{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ose-www-fe-e2e",
  "sourceRoot": "apps/ose-www-fe-e2e/src",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/ose-www-fe-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "apps/ose-www-fe-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/ose-www-fe-e2e"
      }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-www-fe-e2e:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www-fe-e2e:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www-fe-e2e:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www-fe-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/e2e-fixtures/**/*"
      ],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npm exec -- nx run ose-www:build:e2e && npx bddgen && npx playwright test",
        "cwd": "apps/ose-www-fe-e2e"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "apps/ose-www-fe-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/ose-www-fe-e2e"
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-www-fe-e2e/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www-fe-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-www-fe-e2e/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www-fe-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-www-fe-e2e:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www-fe-e2e:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www-fe-e2e/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:ose"],
  "implicitDependencies": ["ose-www"],
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ose/www/behaviours/frontend/**/*.feature"]
  }
}
