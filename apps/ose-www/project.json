{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ose-www/src",
  "projectType": "application",
  "targets": {
    "generate-search-data": {
      "command": "npx tsx src/scripts/generate-search-data.ts",
      "options": {
        "cwd": "apps/ose-www"
      }
    },
    "dev": {
      "command": "node ../../scripts/next-with-port.mjs dev --env OSE_WWW_PORT --default 3100",
      "options": {
        "cwd": "apps/ose-www"
      },
      "dependsOn": []
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/ose-www"
      },
      "dependsOn": ["generate-search-data"],
      "outputs": ["{projectRoot}/.next"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/content/**/*",
        "{projectRoot}/next.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json"
      ],
      "cache": true
    },
    "build:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "OSE_WEB_CONTENT_DIR=\"$PWD/tests/e2e-fixtures/content\" OSE_WEB_SEARCH_DATA_PATH=\"$PWD/tests/e2e-fixtures/search-data.json\" OSE_WEB_SHOW_DRAFTS=false npx next build",
        "cwd": "apps/ose-www"
      },
      "outputs": ["{projectRoot}/.next"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/e2e-fixtures/**/*",
        "{projectRoot}/next.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ],
      "cache": true
    },
    "start": {
      "command": "node ../../scripts/next-with-port.mjs start --env OSE_WWW_PORT --default 3100",
      "options": {
        "cwd": "apps/ose-www"
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "apps/ose-www"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig.json"],
      "cache": true
    },
    "lint": {
      "command": "npx oxlint --jsx-a11y-plugin -c oxlint.json --tsconfig tsconfig.json src/",
      "options": {
        "cwd": "apps/ose-www"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/oxlint.json", "{projectRoot}/tsconfig.json"],
      "cache": true
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run --project unit --project unit-fe --coverage --coverage.thresholds.lines=99",
        "cwd": "apps/ose-www"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/unit/**/*",
        "{projectRoot}/vitest.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/next.config.ts",
        "{projectRoot}/next-env.d.ts",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/backend/**/*.feature",
        "{workspaceRoot}/libs/web-ui/src/**/*",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/frontend/**/*.feature"
      ],
      "cache": true,
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.integration.config.ts --coverage --coverage.thresholds.lines=99",
        "cwd": "apps/ose-www"
      },
      "inputs": [
        "{projectRoot}/src/features/content/**/*",
        "{projectRoot}/tests/integration/**/*",
        "{projectRoot}/tests/e2e-fixtures/**/*",
        "{projectRoot}/vitest.integration.config.ts",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/backend/content/content-retrieval.feature",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/backend/search/search.feature"
      ],
      "cache": true,
      "outputs": ["{projectRoot}/coverage/integration"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-www:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www/vitest.integration.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    },
    "clean": {
      "command": "rm -rf .next"
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-www/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-www/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-www/behaviour-coverage.json --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.integration.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/ose-www/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www/vitest.integration.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ose-www:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www:test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ose-www:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/ose-www/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/ose/www/behaviours/**/*.feature",
        "{workspaceRoot}/apps/ose-www/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www/vitest.config.ts",
        "{workspaceRoot}/apps/ose-www/vitest.integration.config.ts",
        "{workspaceRoot}/apps/ose-www-fe-e2e/src/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/ose-www-fe-e2e/playwright.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": [
      "{workspaceRoot}/specs/apps/ose/www/behaviours/frontend/**/*.feature",
      "{workspaceRoot}/specs/apps/ose/www/behaviours/backend/**/*.feature"
    ]
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:ose"]
}
