<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RhinoCli.Application</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OtherFlags>--warnon:1182 --nowarn:3261 --nowarn:3264 --nowarn:3511</OtherFlags>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <!-- G-Research F# Analyzers: treat all violations as errors in build -->
    <FSharpAnalyzersOtherFlags>--analyzers-path &quot;$(PkgG-Research_FSharp_Analyzers)/analyzers/dotnet/fs&quot; --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001 --verbosity d</FSharpAnalyzersOtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Convention.fs" />
    <Compile Include="src/Parity.fs" />
    <Compile Include="src/RepoConfig.fs" />
    <Compile Include="src/Env.fs" />
    <Compile Include="src/DoctorResource.fs" />
    <Compile Include="src/Doctor.fs" />
    <Compile Include="src/TestCoverage.fs" />
    <Compile Include="src/Md.fs" />
    <Compile Include="src/Governance.fs" />
    <Compile Include="src/Git.fs" />
    <Compile Include="src/HarnessPolicy.fs" />
    <Compile Include="src/HarnessRuntime.fs" />
    <Compile Include="src/Specs.fs" />
    <Compile Include="src/Contracts.fs" />
    <Compile Include="src/TestBoundary.fs" />
    <Compile Include="src/Plan.fs" />
    <Compile Include="src/RepoGovernance.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- F# static analyzers (G-Research) — runs via dotnet msbuild /t:AnalyzeFSharpProject -->
    <PackageReference Include="FSharp.Analyzers.Build" Version="0.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="G-Research.FSharp.Analyzers" Version="0.22.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RhinoCli.Domain/RhinoCli.Domain.fsproj" />
    <ProjectReference Include="../RhinoCli.Infrastructure/RhinoCli.Infrastructure.fsproj" />
  </ItemGroup>
</Project>
