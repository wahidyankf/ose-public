<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RhinoCli.Tests.E2E</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Steps/GitProcessSteps.fs" />
    <Compile Include="Steps/EnvValidateProcessSteps.fs" />
    <Compile Include="Steps/EnvBackupProcessSteps.fs" />
    <Compile Include="Steps/EnvRestoreProcessSteps.fs" />
    <Compile Include="Steps/EnvInitProcessSteps.fs" />
    <Compile Include="Steps/MdProcessSteps.fs" />
    <Compile Include="Steps/SpecsProcessSteps.fs" />
    <Compile Include="Steps/RepoGovernanceProcessSteps.fs" />
    <Compile Include="Steps/GateDeclarationProcessSteps.fs" />
    <Compile Include="Steps/GateEmissionProcessSteps.fs" />
    <Compile Include="Steps/GateEnumerationProcessSteps.fs" />
    <Compile Include="Steps/GateExecutionProcessSteps.fs" />
    <Compile Include="Steps/GateValidationProcessSteps.fs" />
    <Compile Include="Steps/ParityManifestProcessSteps.fs" />
    <Compile Include="Steps/RepoConfigProcessSteps.fs" />
    <Compile Include="Steps/RepoConfigValidateProcessSteps.fs" />
    <Compile Include="Steps/DoctorProcessSteps.fs" />
    <Compile Include="Steps/CargoTargetShareProcessSteps.fs" />
    <Compile Include="Steps/ContractsProcessSteps.fs" />
    <Compile Include="Steps/TestBoundaryProcessSteps.fs" />
    <Compile Include="Steps/TestCoverageProcessSteps.fs" />
    <Compile Include="Steps/ConventionProcessSteps.fs" />
    <Compile Include="Steps/GovernanceProcessSteps.fs" />
    <Compile Include="Steps/HarnessProcessSteps.fs" />
    <Compile Include="Steps/PlanStructureProcessSteps.fs" />
    <Compile Include="Steps/RustDelegationProcessSteps.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TickSpec" Version="2.0.5" />
  </ItemGroup>
</Project>
