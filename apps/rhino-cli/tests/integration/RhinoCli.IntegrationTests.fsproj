    <Compile Include="Steps/EnvValidateResourceSteps.fs" />
    <Compile Include="Steps/EnvContractIacResourceSteps.fs" />
    <Compile Include="Steps/EnvBackupResourceSteps.fs" />
    <Compile Include="Steps/EnvRestoreResourceSteps.fs" />
    <Compile Include="Steps/EnvInitResourceSteps.fs" />
    <Compile Include="Steps/EnvResourceTests.fs" />
    <Compile Include="Steps/EnvInitResourceTests.fs" />
    <Compile Include="Steps/EnvRestoreResourceTests.fs" />
    <Compile Include="Steps/EnvValidateResourceTests.fs" />
    <Compile Include="Steps/EnvContractIacResourceTests.fs" />
    <Compile Include="Steps/FsharpToolInvocationResourceSteps.fs" />
    <Compile Include="Steps/FsharpToolInvocationResourceTests.fs" />
    <Compile Include="Steps/DoctorToolCheckResourceSteps.fs" />
    <Compile Include="Steps/DoctorToolCheckResourceTests.fs" />
    <Compile Include="Steps/CargoTargetShareResourceSteps.fs" />
    <Compile Include="Steps/CargoTargetShareResourceTests.fs" />
    <Compile Include="Steps/ContractsResourceSteps.fs" />
<Compile Include="Steps/TestBoundaryResourceSteps.fs" />
    <Compile Include="Steps/TestCoverageResourceSteps.fs" />
    <Compile Include="Steps/HarnessResourceSteps.fs" />
    <Compile Include="Steps/HarnessResourceTests.fs" />
    <Compile Include="Steps/ConventionResourceSteps.fs" />
    <Compile Include="Steps/ConventionResourceTests.fs" />
    <Compile Include="Steps/GovernanceResourceSteps.fs" />
    <Compile Include="Steps/EnvStagedGuardResourceSteps.fs" />
    <Compile Include="Steps/SpecsResourceSteps.fs" />
    <Compile Include="Steps/RepoGovernanceResourceSteps.fs" />
