<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RhinoCli.Tests.Integration</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 3261/3264: F# nullness interop noise in test data. -->
    <OtherFlags>--nowarn:3261 --nowarn:3264</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Steps/GitRootResourceTests.fs" />
    <Compile Include="Steps/DispatchResourceTests.fs" />
    <Compile Include="Steps/WaveDDispatchResourceTests.fs" />
