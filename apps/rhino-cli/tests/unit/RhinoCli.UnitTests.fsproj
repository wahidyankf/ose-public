<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RhinoCli.Tests.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 3261/3264: F# nullness interop noise in test data. -->
    <OtherFlags>--nowarn:3261 --nowarn:3264</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Steps/ConventionSteps.fs" />
    <Compile Include="Steps/FormattersUnitTests.fs" />
    <Compile Include="Steps/RepoConfigSteps.fs" />
    <Compile Include="Steps/RepoConfigValidateSteps.fs" />
    <Compile Include="Steps/EnvSteps.fs" />
    <Compile Include="Steps/EnvInitSteps.fs" />
    <Compile Include="Steps/EnvRestoreSteps.fs" />
    <Compile Include="Steps/EnvValidateSteps.fs" />
    <Compile Include="Steps/EnvContractIacSteps.fs" />
    <Compile Include="Steps/EnvStagedGuardSteps.fs" />
    <Compile Include="Steps/EnvStagedGuardUnitTests.fs" />
    <Compile Include="Steps/EnvCoverageTests.fs" />
    <Compile Include="Steps/DoctorToolCheckSteps.fs" />
    <Compile Include="Steps/DoctorToolCheckUnitTests.fs" />
    <Compile Include="Steps/DoctorCoverageTests.fs" />
    <Compile Include="Steps/DoctorSteps.fs" />
    <Compile Include="Steps/DoctorUnitTests.fs" />
    <Compile Include="Steps/FsharpToolInvocationSteps.fs" />
    <Compile Include="Steps/FsharpToolInvocationUnitTests.fs" />
    <Compile Include="Steps/TestCoverageSteps.fs" />
    <Compile Include="Steps/TestCoverageUnitTests.fs" />
    <Compile Include="Steps/MdSteps.fs" />
    <Compile Include="Steps/MdPureUnitTests.fs" />
    <Compile Include="Steps/FindingUnitTests.fs" />
    <Compile Include="Steps/GovernanceSteps.fs" />
    <Compile Include="Steps/GitSteps.fs" />
    <Compile Include="Steps/PreCommitPolicySteps.fs" />
    <Compile Include="Steps/WaveDParityRegressionUnitTests.fs" />
    <Compile Include="Steps/WaveDFormattersUnitTests.fs" />
    <Compile Include="Steps/WaveDMermaidWarningUnitTests.fs" />
    <Compile Include="Steps/WaveEFFormattersUnitTests.fs" />
    <Compile Include="Steps/FormattersCoverageTests.fs" />
    <Compile Include="Steps/DddRetirementUnitTests.fs" />
    <Compile Include="Steps/SpecsSteps.fs" />
    <Compile Include="Steps/ContractsSteps.fs" />
    <Compile Include="Steps/HarnessDuplicationSteps.fs" />
    <Compile Include="Steps/HarnessCatalogSteps.fs" />
    <Compile Include="Steps/HarnessBindingsSteps.fs" />
    <Compile Include="Steps/HarnessSyncSteps.fs" />
    <Compile Include="Steps/HarnessClaudeValidationSteps.fs" />
    <Compile Include="Steps/HarnessCodexBindingSteps.fs" />
    <Compile Include="Steps/HarnessWordBudgetRuleSteps.fs" />
    <Compile Include="Steps/HarnessTriageSteps.fs" />
    <Compile Include="Steps/HarnessSkillsMirrorSteps.fs" />
    <Compile Include="Steps/HarnessOwnershipSteps.fs" />
    <Compile Include="Steps/HarnessPrePushSteps.fs" />
    <Compile Include="Steps/HarnessAuditSteps.fs" />
    <Compile Include="Steps/HarnessPolicyCoverageTests.fs" />
    <Compile Include="Steps/RepoGovernanceSteps.fs" />
    <Compile Include="Steps/TestBoundarySteps.fs" />
    <Compile Include="Steps/GateDeclarationSteps.fs" />
    <Compile Include="Steps/GateEmissionSteps.fs" />
    <Compile Include="Steps/GateEnumerationSteps.fs" />
    <Compile Include="Steps/GateExecutionSteps.fs" />
    <Compile Include="Steps/GateValidationSteps.fs" />
    <Compile Include="Steps/ParityManifestSteps.fs" />
    <Compile Include="Steps/PlanStructureSteps.fs" />
    <Compile Include="Steps/OwnedModuleCoverageTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../../specs/apps/rhino/cli/behaviours/**/*.feature" />
    <!-- The shared plan-structure corpus, read in memory so Unit never touches the filesystem. -->
    <EmbeddedResource Include="../../../../specs/fixtures/plan-structure/**" LogicalName="plan-structure/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TickSpec" Version="2.0.5" />
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RhinoCli.Cli/RhinoCli.Cli.fsproj" />
    <ProjectReference Include="../../src/RhinoCli.Application/RhinoCli.Application.fsproj" />
    <ProjectReference Include="../../src/RhinoCli.Domain/RhinoCli.Domain.fsproj" />
    <ProjectReference Include="../../src/RhinoCli.Infrastructure/RhinoCli.Infrastructure.fsproj" />
  </ItemGroup>
</Project>
