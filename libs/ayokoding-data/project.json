{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ayokoding-data",
  "sourceRoot": "libs/ayokoding-data/data",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "libs/ayokoding-data"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --deny-warnings .",
        "cwd": "libs/ayokoding-data"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npx vitest run --coverage --coverage.thresholds.lines=99",
            "forwardAllArgs": false
          },
          {
            "command": "! grep -rnE '\\.(skip|only|todo|fixme)\\(' --include='*.ts' src tests",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "cwd": "libs/ayokoding-data",
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/unit/**/*", "{projectRoot}/vitest.config.ts"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.integration.config.ts",
        "cwd": "libs/ayokoding-data"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/data/**/*",
        "{projectRoot}/test-vectors/**/*",
        "{projectRoot}/provenance.md",
        "{projectRoot}/tests/integration/**/*",
        "{projectRoot}/vitest.integration.config.ts",
        "{workspaceRoot}/specs/libs/ayokoding-data/behaviours/**/*.feature"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ayokoding-data:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-data:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-data:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ayokoding-data:test:behaviour:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/ayokoding-data/behaviours/**/*.feature",
        "{workspaceRoot}/libs/ayokoding-data/data/**/*.{json,md}",
        "{workspaceRoot}/libs/ayokoding-data/provenance.md",
        "{workspaceRoot}/libs/ayokoding-data/test-vectors/**/*.json",
        "{workspaceRoot}/libs/ayokoding-data/src/**/*.ts",
        "{workspaceRoot}/libs/ayokoding-data/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ayokoding-data/vitest.config.ts",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    },
    "test:behaviour:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./rhino behaviour coverage validate",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/rhino.lock",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/apps/ayokoding-www/content/**/*.feature",
        "{workspaceRoot}/apps/*/tests/**/*",
        "{workspaceRoot}/apps/*-e2e/steps/**/*",
        "{workspaceRoot}/apps/*-e2e/src/**/*",
        "{workspaceRoot}/libs/*/tests/**/*"
      ]
    }
  },
  "tags": ["type:lib", "lang:ts", "domain:ayokoding"]
}
