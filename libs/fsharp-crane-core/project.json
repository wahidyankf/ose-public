{
  "name": "fsharp-crane-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/fsharp-crane-core/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build libs/fsharp-crane-core/fsharp-crane-core.fsproj"
      },
      "outputs": ["{projectRoot}/bin", "{projectRoot}/obj"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/fsharp-crane-core.fsproj"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build libs/fsharp-crane-core/fsharp-crane-core.fsproj"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/fsharp-crane-core.fsproj"]
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet tool restore",
          "dotnet tool run fantomas --check libs/fsharp-crane-core/src",
          "dotnet fsharplint lint libs/fsharp-crane-core/fsharp-crane-core.fsproj --lint-config libs/fsharp-crane-core/fsharplint.json",
          "dotnet fsharp-analyzers --project libs/fsharp-crane-core/fsharp-crane-core.fsproj --analyzers-path $(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1) --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/fsharp-crane-core.fsproj"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=' libs/fsharp-crane-core/tests/unit; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && dotnet test libs/fsharp-crane-core/tests/unit/fsharp-crane-core-unit-tests.fsproj /p:CollectCoverage=true /p:Threshold=99 /p:ThresholdType=line \"/p:ExcludeByFile=**/Adapters/Out/PdfAdapter.fs%2C**/Adapters/Out/OcrAdapter.fs%2C**/Core/Logic/ReportManager.fs%2C**/Core/Logic/SkiplistManager.fs%2C**/Core/Logic/PdfExtractionCache.fs\""
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/tests/unit/fsharp-crane-core-unit-tests.fsproj",
        "{projectRoot}/fsharp-crane-core.fsproj",
        "{workspaceRoot}/specs/libs/fsharp-crane-core/behaviours/**/*.feature"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=' libs/fsharp-crane-core/tests/integration; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && dotnet test libs/fsharp-crane-core/tests/integration/fsharp-crane-core-integration-tests.fsproj"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/tests/integration/**/*"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run fsharp-crane-core:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-crane-core:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-crane-core:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-crane-core:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-crane-core/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-crane-core/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/fsharp-crane-core-unit-tests.fsproj",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/fsharp-crane-core-integration-tests.fsproj"
      ]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet list libs/fsharp-crane-core/fsharp-crane-core.fsproj package --vulnerable"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for F#'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/fsharp-crane-core/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-crane-core/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-crane-core/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/fsharp-crane-core-unit-tests.fsproj"
      ]
    },
    "test:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/fsharp-crane-core/behaviour-coverage.json --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-crane-core/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-crane-core/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/fsharp-crane-core-unit-tests.fsproj",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/fsharp-crane-core-integration-tests.fsproj"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/fsharp-crane-core/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-crane-core/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-crane-core/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/fsharp-crane-core-unit-tests.fsproj",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/fsharp-crane-core-integration-tests.fsproj"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run fsharp-crane-core:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-crane-core:test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-crane-core:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-crane-core/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-crane-core/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/unit/fsharp-crane-core-unit-tests.fsproj",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-crane-core/tests/integration/fsharp-crane-core-integration-tests.fsproj"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/fsharp-crane-core/behaviours/**/*.feature"]
  },
  "tags": ["type:lib", "domain:crane", "lang:fsharp"],
  "implicitDependencies": []
}
