{
  "name": "fsharp-env-loader",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/fsharp-env-loader/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build libs/fsharp-env-loader/fsharp-env-loader.fsproj"
      },
      "outputs": ["{projectRoot}/bin", "{projectRoot}/obj"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/fsharp-env-loader.fsproj"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build libs/fsharp-env-loader/fsharp-env-loader.fsproj"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/fsharp-env-loader.fsproj"]
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet tool restore",
          "dotnet tool run fantomas --check libs/fsharp-env-loader/src",
          "dotnet fsharplint lint libs/fsharp-env-loader/fsharp-env-loader.fsproj --lint-config libs/fsharp-env-loader/fsharplint.json",
          "dotnet fsharp-analyzers --project libs/fsharp-env-loader/fsharp-env-loader.fsproj --analyzers-path $(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1) --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/fsharp-env-loader.fsproj"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=' libs/fsharp-env-loader/tests/unit; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && dotnet test libs/fsharp-env-loader/tests/unit/fsharp-env-loader-unit-tests.fsproj /p:CollectCoverage=true /p:Threshold=99 /p:ThresholdType=line"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/fsharp-env-loader.fsproj"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=' libs/fsharp-env-loader/tests/integration; then echo 'ERROR: xunit Skip= attribute found in integration tests above'; exit 1; fi && dotnet test libs/fsharp-env-loader/tests/integration/fsharp-env-loader-integration-tests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/integration/**/*.fs",
        "{projectRoot}/fsharp-env-loader.fsproj"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run fsharp-env-loader:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-env-loader:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-env-loader:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-env-loader:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/fsharp-env-loader-unit-tests.fsproj",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/fsharp-env-loader-integration-tests.fsproj"
      ]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet list libs/fsharp-env-loader/fsharp-env-loader.fsproj package --vulnerable"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for F#'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/fsharp-env-loader/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/fsharp-env-loader-unit-tests.fsproj"
      ]
    },
    "test:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/fsharp-env-loader/behaviour-coverage.json --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/fsharp-env-loader-integration-tests.fsproj"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/fsharp-env-loader/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/fsharp-env-loader-unit-tests.fsproj",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/fsharp-env-loader-integration-tests.fsproj"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run fsharp-env-loader:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-env-loader:test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run fsharp-env-loader:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/fsharp-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/fsharp-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/unit/fsharp-env-loader-unit-tests.fsproj",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/fsharp-env-loader/tests/integration/fsharp-env-loader-integration-tests.fsproj"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/fsharp-env-loader/behaviours/**/*.feature"]
  },
  "tags": ["type:lib", "domain:config", "lang:fsharp"],
  "implicitDependencies": []
}
