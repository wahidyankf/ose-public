{
  "name": "ts-env-loader",
  "sourceRoot": "libs/ts-env-loader/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "libs/ts-env-loader"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "libs/ts-env-loader"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npx vitest run --coverage --coverage.thresholds.lines=99",
            "forwardAllArgs": false
          },
          {
            "command": "! grep -rnE '\\.(skip|todo)\\(' --include='*.test.*' --include='*.steps.*' src",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "cwd": "libs/ts-env-loader",
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/unit/**/*"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.integration.config.ts --coverage --coverage.thresholds.lines=99",
        "cwd": "libs/ts-env-loader"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/integration/**/*",
        "{projectRoot}/vitest.integration.config.ts"
      ],
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.e2e.config.ts",
        "cwd": "libs/ts-env-loader"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/next-with-port.mjs",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/e2e/**/*",
        "{projectRoot}/vitest.e2e.config.ts"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ts-env-loader:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ts-env-loader:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ts-env-loader:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ts-env-loader:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/ts-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/ts-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/ts-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.integration.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.e2e.config.ts"
      ]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/ts-env-loader/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/ts-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/ts-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/ts-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/vitest.integration.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/vitest.e2e.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/ts-env-loader/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/ts-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/ts-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/ts-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/vitest.integration.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/vitest.e2e.config.ts"
      ]
    },
    "test:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/ts-env-loader/behaviour-coverage.json --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/ts-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/ts-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/ts-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.integration.config.ts"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/ts-env-loader/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/ts-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/ts-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/ts-env-loader/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.e2e.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run ts-env-loader:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ts-env-loader:test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ts-env-loader:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run ts-env-loader:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/ts-env-loader/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/ts-env-loader/behaviours/**/*.feature",
        "{workspaceRoot}/libs/ts-env-loader/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/ts-env-loader/vitest.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/vitest.integration.config.ts",
        "{workspaceRoot}/libs/ts-env-loader/vitest.e2e.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/ts-env-loader/behaviours/**/*.feature"]
  },
  "tags": ["type:lib", "lang:ts", "domain:config"]
}
