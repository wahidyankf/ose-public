{
  "name": "web-ui-token",
  "sourceRoot": "libs/web-ui-token/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "libs/web-ui-token"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No lint configured for web-ui-token (CSS + minimal TS)'"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npx vitest run --coverage --coverage.thresholds.lines=99",
            "forwardAllArgs": false
          },
          {
            "command": "! grep -rnE '\\.(skip|todo)\\(' --include='*.test.*' --include='*.steps.*' src",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "cwd": "libs/web-ui-token",
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/unit/**/*"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run web-ui-token:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run web-ui-token:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run web-ui-token:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run web-ui-token:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/web-ui-token/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/web-ui-token/behaviours/**/*.feature",
        "{workspaceRoot}/libs/web-ui-token/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/web-ui-token/vitest.config.ts"
      ]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/web-ui-token/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/web-ui-token/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/web-ui-token/behaviours/**/*.feature",
        "{workspaceRoot}/libs/web-ui-token/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/web-ui-token/vitest.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config libs/web-ui-token/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/web-ui-token/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/web-ui-token/behaviours/**/*.feature",
        "{workspaceRoot}/libs/web-ui-token/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/web-ui-token/vitest.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run web-ui-token:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run web-ui-token:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/libs/web-ui-token/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/libs/web-ui-token/behaviours/**/*.feature",
        "{workspaceRoot}/libs/web-ui-token/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/libs/web-ui-token/vitest.config.ts"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/web-ui-token/behaviours/**/*.feature"]
  },
  "tags": ["type:lib", "lang:ts", "domain:ui"]
}
