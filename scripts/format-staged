#!/usr/bin/env bash
# Apply the repository's existing formatters only to paths selected by Rhino's
# index snapshot. Rhino owns re-staging and disposable PR replay; this helper
# owns language-specific formatter selection and never queries Git.
set -euo pipefail

prettier_paths=()
rust_paths=()
fsharp_paths=()
python_paths=()
go_paths=()
elixir_paths=()
csharp_paths=()
dart_paths=()
java_paths=()
shell_paths=()
tofu_paths=()
lua_paths=()
c_paths=()
build_paths=()
snapshot_root=$(pwd -P)

# A global Fantomas app host cannot inherit the .NET runtime location from the
# `dotnet` launcher. Discover the installed runtime only when an F# path needs
# it, so Husky works on Homebrew and other layouts without a machine path.
prepare_fantomas_runtime() {
  local runtime_path dotnet_root
  [[ -n "${DOTNET_ROOT:-}" ]] && return 0

  runtime_path=$(dotnet --list-runtimes | awk '/^Microsoft\.NETCore\.App / { print $NF; exit }') || {
    printf 'format-staged: cannot inspect the installed .NET runtime\n' >&2
    return 1
  }
  runtime_path=${runtime_path#\[}
  runtime_path=${runtime_path%\]}
  dotnet_root=${runtime_path%/shared/Microsoft.NETCore.App}
  if [[ "$dotnet_root" == "$runtime_path" || ! -x "$dotnet_root/dotnet" ]]; then
    printf 'format-staged: cannot locate the installed .NET runtime\n' >&2
    return 1
  fi
  export DOTNET_ROOT="$dotnet_root"
}

for path in "$@"; do
  # Deleted paths are intentional in an index snapshot and have no bytes to format.
  [[ -f "$path" ]] || continue

  case "$path" in
    *.md | *.js | *.jsx | *.ts | *.tsx | *.mjs | *.cjs | *.json | *.yml | *.yaml | *.css | *.scss | *.html | *.sql)
      prettier_paths+=("$path")
      ;;
    *.rs) rust_paths+=("$path") ;;
    *.fs) fsharp_paths+=("$path") ;;
    *.py) python_paths+=("$path") ;;
    *.go) go_paths+=("$path") ;;
    *.ex | *.exs) elixir_paths+=("$path") ;;
    *.cs) csharp_paths+=("$path") ;;
    *.dart) dart_paths+=("$path") ;;
    *.java) java_paths+=("$path") ;;
    *.sh) shell_paths+=("$path") ;;
    *.tf) tofu_paths+=("$path") ;;
    *.lua) lua_paths+=("$path") ;;
    *.c | *.h) c_paths+=("$path") ;;
    BUILD | BUILD.bazel | *.bzl) build_paths+=("$path") ;;
  esac
done

if (( ${#prettier_paths[@]} > 0 )); then
  prettier_path=$(command -v prettier)
  prettier_bin_directory=$(CDPATH='' cd -P -- "$(dirname "$prettier_path")" && pwd)
  node_modules_directory=$(CDPATH='' cd -P -- "$prettier_bin_directory/.." && pwd)
  repository_root=$(CDPATH='' cd -P -- "$node_modules_directory/.." && pwd)
  prettier_config=$(mktemp "${TMPDIR:-/tmp}/ose-prettier-snapshot-config.XXXXXX")
  /bin/mv "$prettier_config" "$prettier_config.json"
  prettier_config="$prettier_config.json"
  trap '/bin/rm -f -- "$prettier_config"' EXIT HUP INT TERM

  node scripts/prettier-snapshot-config.mjs \
    "$snapshot_root/.prettierrc.json" \
    "$repository_root" \
    "$node_modules_directory" \
    "$snapshot_root" \
    "$prettier_config"
  prettier --config "$prettier_config" --write "${prettier_paths[@]}"
fi
(( ${#rust_paths[@]} == 0 )) || rustfmt --edition 2024 "${rust_paths[@]}"
if (( ${#fsharp_paths[@]} > 0 )); then
  prepare_fantomas_runtime
  fantomas "${fsharp_paths[@]}"
fi
(( ${#python_paths[@]} == 0 )) || ruff format "${python_paths[@]}"
(( ${#go_paths[@]} == 0 )) || gofmt -w "${go_paths[@]}"
(( ${#elixir_paths[@]} == 0 )) || scripts/format-elixir.sh "${elixir_paths[@]}"
(( ${#csharp_paths[@]} == 0 )) || csharpier format "${csharp_paths[@]}"
(( ${#dart_paths[@]} == 0 )) || dart format "${dart_paths[@]}"
(( ${#java_paths[@]} == 0 )) || scripts/format-java.sh "${java_paths[@]}"
(( ${#shell_paths[@]} == 0 )) || shfmt -w "${shell_paths[@]}"
(( ${#tofu_paths[@]} == 0 )) || tofu fmt "${tofu_paths[@]}"
(( ${#lua_paths[@]} == 0 )) || stylua "${lua_paths[@]}"
(( ${#c_paths[@]} == 0 )) || clang-format -i "${c_paths[@]}"
(( ${#build_paths[@]} == 0 )) || buildifier "${build_paths[@]}"
